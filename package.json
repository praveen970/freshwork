{
  "name": "freshwork",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "test": "npm run test -w backend",
    "start": "npm run start -w backend",
    "format": "prettier --write frontend/src backend/src *.json frontend/*.js frontend/*.html"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "prettier": "^3.9.7"
  }
}
